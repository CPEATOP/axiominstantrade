{
  "manifest_version": 3,
  "name": "Axiom Instant Trade Skin",
  "version": "1.0.2",
  "description": "Свой фон для панели Instant Trade на axiom.trade: цвет, градиент или картинка/GIF.",
  "permissions": ["storage", "unlimitedStorage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Фон Instant Trade",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_ui": { "page": "popup.html", "open_in_tab": true },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://axiom.trade/*", "https://*.axiom.trade/*"],
      "js": ["defaults.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
